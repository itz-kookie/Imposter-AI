# Which AI provider drives the bots: gemini | mistral | openai. Defaults to gemini.
AI_PROVIDER=gemini

# --- gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- mistral ---
# MISTRAL_API_KEY=your_mistral_api_key_here
# Optional. Defaults to ministral-14b-latest.
# MISTRAL_MODEL=ministral-14b-latest

# --- openai: any OpenAI-compatible chat-completions endpoint (Groq, OpenRouter, OpenAI, NVIDIA NIM, ...) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=openai/gpt-oss-120b
